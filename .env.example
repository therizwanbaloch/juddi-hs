# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Connection URI (leave empty to use persistent local JSON datastore fallback in preview)
MONGODB_URI=

# Strong random secret for signing admin JWT sessions (required for Vercel / production)
JWT_SECRET=

# Initial Admin Account Credentials (optional; if unset, first-run setup UI claims the initial admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary Image Storage (leave empty to use local uploads/plots fallback in preview)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
